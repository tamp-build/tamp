<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tamp's self-hosted build script. Drives the project's own
    restore / build / test / pack flow via the framework being
    built. Single-target net10 (only place we don't multi-target —
    the build script just runs on whichever .NET 10 SDK is local).
    IsPackable=false; the build script is never published.

    ProjectReferences (not PackageReferences) wire to the in-tree
    Tamp.Core and Tamp.NetCli.V10. That means a change to either
    flows through to the next `dotnet run` of this project
    without a republish round-trip.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tamp.Build</RootNamespace>
    <AssemblyName>Tamp.Build</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Build scripts don't need most of the inherited package metadata. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- In-tree ProjectReferences — Core / NetCli / coverage / SARIF + SBOM contracts
         all still live in this repo. Tamp.Security.Pipeline too — it's the meta-package
         that orchestrates the chain, with PackageReferences to the satellite-shipped
         scanners. -->
    <ProjectReference Include="..\src\Tamp.Core\Tamp.Core.csproj" />
    <ProjectReference Include="..\src\Tamp.NetCli.V10\Tamp.NetCli.V10.csproj" />
    <ProjectReference Include="..\src\Tamp.DotNetCoverage.V18\Tamp.DotNetCoverage.V18.csproj" />
    <ProjectReference Include="..\src\Tamp.Sarif\Tamp.Sarif.csproj" />
    <ProjectReference Include="..\src\Tamp.Sbom\Tamp.Sbom.csproj" />
    <ProjectReference Include="..\src\Tamp.Security.Pipeline\Tamp.Security.Pipeline.csproj" />

    <!-- Cross-repo PackageReferences. The Wave 1+2 security chain wrappers live in
         their own satellite repos (TAM-254 split):
           - tamp-cyclonedx       → Tamp.CycloneDx.V6
           - tamp-opengrep        → Tamp.OpenGrep
           - tamp-osv-scanner     → Tamp.OsvScanner.V2
           - tamp-trivy           → Tamp.Trivy
           - tamp-dependency-track→ Tamp.DependencyTrack.V1
           - tamp-defectdojo      → Tamp.DefectDojo.V2
         Plus tamp-sonar (Tamp.SonarScanner.V10). All pinned via
         Directory.Packages.props. -->
    <PackageReference Include="Tamp.SonarScanner.V10" />
    <PackageReference Include="Tamp.CycloneDx.V6" />
    <PackageReference Include="Tamp.OpenGrep" />
    <PackageReference Include="Tamp.OsvScanner.V2" />
    <PackageReference Include="Tamp.Trivy" />
    <PackageReference Include="Tamp.DependencyTrack.V1" />
    <PackageReference Include="Tamp.DefectDojo.V2" />
  </ItemGroup>

</Project>
