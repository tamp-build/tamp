<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dogfood tool: pushes tamp-core's own build evidence to tamp-findings and
    queries the ship gate. Build/CI tooling ONLY — deliberately NOT in Tamp.slnx
    and never packed. Depends on published satellite packages (Tamp.Ingest.V1,
    Tamp.Conformance) the way any external adopter would, so it exercises the
    real egress contract. Invoked by .github/workflows/nightly.yml and release.yml.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
    <AssemblyName>tamp-findings-ingest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tamp.Core" Version="1.17.3" />
    <PackageReference Include="Tamp.Sbom" Version="1.17.3" />
    <PackageReference Include="Tamp.Sarif" Version="1.17.3" />
    <PackageReference Include="Tamp.Ingest.V1" Version="0.2.2" />
    <PackageReference Include="Tamp.Conformance" Version="0.1.0" />
    <PackageReference Include="Tamp.Conformance.Quality" Version="0.1.0" />
  </ItemGroup>

</Project>
