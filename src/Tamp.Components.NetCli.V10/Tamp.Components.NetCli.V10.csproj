<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Tamp.Components.NetCli.V10</RootNamespace>
    <AssemblyName>Tamp.Components.NetCli.V10</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>Tamp.Components.NetCli.V10</PackageId>
    <Description>Concrete dotnet SDK bodies for the Tamp.Components target shapes (ADR 0020): IDotNetRestore / IDotNetCompile / IDotNetTest / IDotNetPack provide the Restore/Compile/Test/Pack CommandPlans via the .NET 10 `dotnet` CLI (Tamp.NetCli.V10), bundling current best practice (no-restore/no-build chaining, --blame-crash on test). Compose a standard build with `class Build : TampBuild, IDotNetTest, IDotNetPack` and satisfy the IHaz* contracts.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tamp.Components\Tamp.Components.csproj" />
    <ProjectReference Include="..\Tamp.NetCli.V10\Tamp.NetCli.V10.csproj" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

</Project>
