<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Tamp.Migrate</RootNamespace>
    <AssemblyName>Tamp.Migrate</AssemblyName>
  </PropertyGroup>

  <!--
    ADR 0021: a separate dotnet tool, so the `tamp` tool every CI run installs doesn't carry
    Roslyn for a one-off job. IsPackable stays false until the tool is ready to ship (project
    generation, the verify option, the `tamp migrate nuke` forwarder); release.yml packs every packable project.
  -->
  <PropertyGroup Label="Tool">
    <PackageId>Tamp.Migrate</PackageId>
    <IsPackable>false</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tamp-migrate</ToolCommandName>
    <RollForward>Major</RollForward>
    <Description>Migrates a NUKE build to Tamp (ADR 0021). A syntactic Roslyn rewrite that applies the auto-tier rows of the NUKE-to-Tamp mapping, leaves a // TAMP-MIGRATE(rule-id) marker at every site it won't touch, and writes a coverage report. It never compiles or restores the NUKE build.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <!-- The mapping is embedded, so a given tool version always applies the mapping it was tested with. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\nuke-migration\mapping.yaml" LogicalName="Tamp.Migrate.mapping.yaml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tamp.Migrate.Tests" />
  </ItemGroup>

</Project>
