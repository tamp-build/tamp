<Project>

  <!-- Chain to the repo-root props (MSBuild imports only the nearest Directory.Build.props). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!--
      #3: emit the XML documentation file for the shippable libraries under src/ so
      NuGet packs lib/**/*.xml next to each .dll. Scoped here (not repo-root) so test
      and build-only projects don't generate docs they never ship.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
