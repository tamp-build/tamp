<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Tamp.Security.Pipeline</RootNamespace>
    <AssemblyName>Tamp.Security.Pipeline</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>Tamp.Security.Pipeline</PackageId>
    <Description>Tamp meta-package — one PackageReference, one base-class inheritance, get the whole Wave 1+2 security chain: CycloneDX SBOM → SAST (OpenGrep + Roslyn) → SCA (osv-scanner + Dependency-Track) → Trivy secrets+misconfig → DefectDojo reimport. Adopters override `SecurityProductName` + `SecuritySolutionPath` and run `tamp Security`. DT and DD legs are env-var-gated; producer half runs unconditionally. .NET-focused for v0 — non-.NET adopters override Sbom to use Tamp.Syft instead.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- In-tree references — Core + contract packages + NetCli still live in this repo. -->
    <ProjectReference Include="..\Tamp.Core\Tamp.Core.csproj" />
    <ProjectReference Include="..\Tamp.Sarif\Tamp.Sarif.csproj" />
    <ProjectReference Include="..\Tamp.Sbom\Tamp.Sbom.csproj" />
    <ProjectReference Include="..\Tamp.NetCli.V10\Tamp.NetCli.V10.csproj" />

    <!-- Cross-repo PackageReferences — security-chain wrappers split out to satellite
         repos in TAM-254 (1.11.2). Versions pinned via Directory.Packages.props. -->
    <PackageReference Include="Tamp.CycloneDx.V6" />
    <PackageReference Include="Tamp.OpenGrep" />
    <PackageReference Include="Tamp.OsvScanner.V2" />
    <PackageReference Include="Tamp.Trivy" />
    <PackageReference Include="Tamp.DependencyTrack.V1" />
    <PackageReference Include="Tamp.DefectDojo.V2" />

    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

</Project>
