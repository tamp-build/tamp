      "forbiddenPattern": "\u003CPackageReference\\s\u002BInclude=\u0022OpenTelemetry",
      "scope": [
        "**/Tamp.Core/**/*.csproj",
        "**/Tamp.Core.csproj"
      ],
      "controlRefs": [
        "CM-6"
      ]
    },
    {
      "id": "0018-r2",
      "claim": "Tamp.Core emits ActivitySource spans and Meter counters/histograms from the .NET BCL.",
      "kind": "deterministic",
      "requiredPattern": "System\\.Diagnostics\\.(Metrics)?",
      "scope": [
        "**/Tamp.Core/**/*.cs"
      ],
      "controlRefs": [
        "AU-12"
      ]
    },
    {
      "id": "0018-r3",
      "claim": "Three namespaced ActivitySource instances named Tamp.Build, Tamp.Build.Targets, Tamp.Build.Commands.",
      "kind": "deterministic",
      "requiredPattern": "new ActivitySource\\(\\s*\u0022Tamp\\.Build",
      "scope": [
        "**/Tamp.Core/**/*.cs"
      ],
      "controlRefs": [
        "AU-12"
      ]
    },
    {
      "id": "0018-r4",
      "claim": "Single Meter named Tamp.Build.",
      "kind": "deterministic",
      "requiredPattern": "new Meter\\(\\s*\u0022Tamp\\.Build\u0022",
      "scope": [
        "**/Tamp.Core/**/*.cs"
      ],
      "controlRefs": [
        "AU-12"
      ]
    },
    {
